{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["../api/node_modules/@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "../api/src/lib/**/*.ts", "../api/src/db/**/*.ts"],
  "exclude": ["../api/src/lib/**/*.test.ts"]
}
